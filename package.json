{
  "name": "dsh-barricade",
  "version": "0.1.0",
  "description": "Barricade: 编码 agent 的破坏性命令拦截闸门。在 rm -rf、git reset --hard 等命令真正落地前解析、判定并要求确认。dsh 插件 + 通用 CLI。",
  "type": "module",
  "main": "plugin.js",
  "bin": {
    "barricade": "bin/barricade.js"
  },
  "files": [
    "bin/",
    "src/",
    "plugin.js",
    "cordis.patch.yml",
    "examples/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.13"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "safety",
    "guard"
  ]
}
